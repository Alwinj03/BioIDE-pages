# Where the BioIDE backend lives.
#
# Leave unset for local development (the Vite dev server proxies /api to
# http://127.0.0.1:8000) and for the single-process deployment where the
# backend serves the built frontend itself.
#
# Set it when the frontend is deployed separately — on Vercel, with the
# backend on a container host. No trailing slash.
#
# VITE_API_BASE=https://bioide-api.onrender.com
