# Copy to .env and source it, or export these before starting uvicorn.
# Nothing here is required: every analysis endpoint works with all of it unset.

# --- Conversational agent (optional) -----------------------------------------
# Without a key, BioAgent falls back to deterministic keyword routing.
# ANTHROPIC_API_KEY=sk-ant-...
# BIOIDE_LLM_MODEL=claude-sonnet-4-5

# Any OpenAI-compatible endpoint works too, including a local model server.
# OPENAI_API_KEY=sk-...
# BIOIDE_LLM_BASE_URL=http://localhost:11434/v1
# BIOIDE_LLM_MODEL=qwen2.5:14b

# --- Literature APIs (optional, improves rate limits) ------------------------
# BIOIDE_CONTACT_EMAIL=you@university.edu
# NCBI_API_KEY=...

# --- Execution permissions ---------------------------------------------------
# Both default as shown. Set both to 0 on any shared deployment.
BIOIDE_ALLOW_CODE_EXEC=1
BIOIDE_ALLOW_LOCAL_INSTALL=0
BIOIDE_EXEC_TIMEOUT=120
BIOIDE_EXEC_MEM_MB=2048
BIOIDE_MAX_UPLOAD_MB=50

# --- Storage -----------------------------------------------------------------
# BIOIDE_DATA_DIR=~/.bioide
